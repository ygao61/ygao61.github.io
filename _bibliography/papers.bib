@article{gao2026alevinfryforseti,
  abbr        = {Under review},
  preview     = {alevin-fry-forseti.svg},
  bibtex_show = {true},
  title       = {Alevin-fry-Forseti Enhances Single Cell Quantification via Mechanistic-informed Multimapping Resolution},
  author      = {Gao, Yuan and He, Dongze and Patro, Rob},
  journal     = {Manuscript under review},
  year        = {2026},
  abstract    = {Single-cell quantification pipelines routinely discard reads that map to more than one gene, silently removing exactly the loci where gene families overlap. We present alevin-fry-forseti, an end-to-end quantification tool that integrates mechanistic probabilistic modeling of splicing status directly into graph-based UMI deduplication rather than treating multimapping as a post hoc tie-break. Validated against matched long-read data, our reassignments show 2.5x higher long-read confirmation than a parsimony-EM baseline and recover 2.7x more calls than Cell Ranger (288K vs. 106K). The resulting count matrices disentangle overlapping loci such as MS4A and rescue functional biomarkers -- including the antioxidant regulator GPX1 in dendritic cells -- that mechanism-unaware heuristics routinely drop as noise. On a human MTG snRNA-seq atlas (9,103 cells, 19 expert-curated subclasses) it achieves the highest clustering agreement (NMI/ARI) of any method tested, significantly beating Cell Ranger (p=0.006). Systematic performance engineering in Rust delivers a 75x speedup.},
  code        = {https://github.com/COMBINE-lab/alevin-fry/tree/forseti},
  selected    = {true}
}

@inproceedings{kontogiorgosheintz2026barcall,
  abbr        = {ISMB},
  preview     = {barcall.png},
  bibtex_show = {true},
  title       = {BarCall: a deep-learning base caller for Optical Pooled Screens},
  author      = {Kontogiorgos-Heintz, Dimitri and Gao, Yuan and Hleap, Jose Sergio and Richmond, David and Gould, Joshua and Ge, Xiaoyan Monica and Li, Bo},
  booktitle   = {ISMB 2026 (Abstract)},
  code        = {https://github.com/Genentech/barcall},
  year        = {2026},
  abstract    = {Conventional in situ sequencing pipelines decouple spot detection from base calling, which caps accuracy and rules out self-supervision. BarCall performs both jointly in a single end-to-end framework, making self-supervised learning possible for Optical Pooled Screens. It recovers substantially more usable cells (~18.5%) for downstream analysis with strong cross-plate generalizability, directly increasing the effective yield of high-throughput OPS.},
  annotation  = {Work done during a research internship at Genentech.},
  selected    = {true}
}

@article{gao2026qcatch,
  abbr        = {Bioinformatics},
  preview     = {qcatch.jpg},
  bibtex_show = {true},
  title       = {QCatch: a framework for quality control assessment and analysis of single-cell sequencing data},
  author      = {Gao*, Yuan and He*, Dongze and Patro, Rob},
  journal     = {Bioinformatics},
  volume      = {42},
  number      = {5},
  year        = {2026},
  publisher   = {Oxford University Press},
  doi         = {10.1093/bioinformatics/btag184},
  abstract    = {A quantification tool is only as useful as your ability to tell when it has gone wrong. QCatch is a Python diagnostic framework for the alevin-fry ecosystem that performs automated cell calling and generates comprehensive, interactive HTML quality-control reports. It standardizes outputs into the widely adopted H5AD format, so QC results drop straight into existing downstream analysis workflows instead of requiring a separate detour.},
  code        = {https://github.com/COMBINE-lab/QCatch},
  demo        = {https://combine-lab.github.io/QCatch/demo/demo.html},
  annotation  = {* Equal contribution.},
  selected    = {true}
}

@article{he2024forseti,
  abbr        = {ISMB},
  preview     = {forseti.jpg},
  bibtex_show = {true},
  title       = {Forseti: a mechanistic and predictive model of the splicing status of scRNA-seq reads},
  author      = {He*, Dongze and Gao*, Yuan and Chan, Spencer Skylar and Quintana-Parrilla, Natalia and Patro, Rob},
  journal     = {ISMB 2024 Proceedings (Bioinformatics)},
  volume      = {40},
  number      = {Supplement\_1},
  pages       = {i297--i306},
  year        = {2024},
  publisher   = {Oxford University Press},
  doi         = {10.1093/bioinformatics/btae207},
  abstract    = {Whether a single-cell RNA-seq read originated from a spliced or unspliced molecule is ambiguous, and that ambiguity propagates into every downstream velocity and quantification estimate. Forseti is the first probabilistic model to resolve gene multi-mapping and splicing-status ambiguity mechanistically -- from a model of the underlying library preparation -- rather than by heuristic. It couples a predictive model of fragment-length distribution with a learned model of priming-site affinity to assign each read a principled splicing-status probability.},
  code        = {https://github.com/COMBINE-lab/forseti},
  annotation  = {* Equal contribution.},
  selected    = {true}
}

@article{gao2024collapsibletree,
  abbr        = {Bioinformatics},
  preview     = {collapsible-tree.jpg},
  bibtex_show = {true},
  title       = {Collapsible tree: interactive web app to present collapsible hierarchies},
  author      = {Gao, Yuan and Patro, Rob and Jiang, Peng},
  journal     = {Bioinformatics},
  volume      = {40},
  number      = {11},
  pages       = {btae645},
  year        = {2024},
  publisher   = {Oxford University Press},
  doi         = {10.1093/bioinformatics/btae645},
  code        = {https://github.com/data2intelligence/collapsible_tree},
  webserver   = {https://collapsibletree.cbcb.umd.edu},
  abstract    = {Cell-type hierarchies are easier to reason about when you can move through them. This full-stack platform (Django/D3.js) turns high-dimensional scRNA-seq count matrices into interactive, collapsible cell-lineage trees built on hierarchical ontologies, letting researchers zoom dynamically between broad lineages and specific subtypes while expression is recomputed at each resolution.},
  annotation  = {Work done at the National Cancer Institute, NIH.}
}

@article{cui2021crispview,
  abbr        = {NAR},
  preview     = {crisp-view.jpg},
  bibtex_show = {true},
  title       = {CRISP-view: a database of functional genetic screens spanning multiple phenotypes},
  author      = {Cui, Yingbo and Cheng, Xiaolong and Chen, Qing and Song, Bicna and Chiu, Anthony and Gao, Yuan and Dawson, Tyson and Chao, Lumen and Zhang, Wubing and Li, Dian and Zeng, Zexiang and Yu, Jijun and Li, Zexu and Fei, Teng and Peng, Shaoliang and Li, Wei},
  journal     = {Nucleic Acids Research},
  volume      = {49},
  number      = {D1},
  pages       = {D848--D854},
  year        = {2021},
  publisher   = {Oxford University Press},
  doi         = {10.1093/nar/gkaa809},
  abstract    = {CRISP-view collects CRISPR/Cas9 and RNAi screening datasets spanning in vitro and in vivo proliferation and viability, response to cancer immunotherapy, virus response, and protein expression -- 10,321 human and 825 mouse samples from 167 papers as of September 2020. Every dataset is curated, annotated, and processed through a standard MAGeCK-VISPR pipeline with quality-control metrics, and served through a webserver for visualization, exploration, and search.},
  webserver   = {http://crispview.weililab.org/}
}
